# Use a multi-stage build strategy

# Stage 1: Build the application using a JDK image with build tools
# ?? ??? ??? - JDK?? ?? ???(Gradle ??? Maven)? ?????????? ???
FROM eclipse-temurin:17-jdk-alpine AS builder
# JDK 17 Alpine Linux ????? ??? (??? ??)

# ????????? ??? ??? ???????? ?????? ???
WORKDIR /app

# Gradle Wrapper ???, ??? ???, ?? ????? ??
# ???????????? ??? ???? ??? ????? ?? ??
COPY gradlew .
COPY gradle ./gradle
COPY build.gradle .

# ????????? ??? ?? ??
COPY src ./src

# gradlew ??? ?? ???
RUN chmod +x gradlew

# Gradle???????? ????????? ??
# -x test????????????????? ?? ??? ??? (????? ?? ?????????????????????)
RUN ./gradlew clean build -x test

# Stage 2: Create the final runtime image using a smaller JRE image
# ??? ??? ??? - ????????? ??????????JRE???????????? ????? ???
FROM eclipse-temurin:17-jre-alpine

# Patch OS packages before runtime (Trivy HIGH with fixes: libexpat/p11-kit etc.)
RUN apk upgrade --no-cache \
 && apk add --no-cache --upgrade "libexpat>=2.8.5-r0"
# JRE 17 Alpine Linux ????? ???

# ?? ?????????? ?????? ???
WORKDIR /app

# ?? ?????????? ???????? ???? JAR ??? ??
# build/libs/*.jar ????Gradle???? ?? ?? JAR ??? ????????
# Maven ????????? target/*.jar ???????.
COPY --from=builder /app/build/libs/*.jar app.jar

# ???????????????? ??? ??? (??? ?????? ?????????????????????????)
# ????? ???????????? application.yml ??????????server.port?? ?????? ?????
EXPOSE 8091

# ????? ??? ??????????????
# ????app.jar ?????java -jar ????? ????????
ENTRYPOINT ["java", "-jar", "app.jar"]

# ??? ???: ?? ??????? root ??????? ??? ?? ????????
