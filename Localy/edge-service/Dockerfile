# Stage 2: Create the final runtime image using a smaller JRE image
# ?¤í–‰ ?˜ê²½ ?¤ì • - ? í”Œë¦¬ì??´ì…˜ ?¤í–‰???„ìš”??JREë§??¬í•¨????ê°€ë²¼ìš´ ?´ë?ì§€ ?¬ìš©
FROM eclipse-temurin:17-jre-alpine

# Patch OS packages before runtime (Trivy HIGH with fixes: libexpat/p11-kit etc.)
RUN apk upgrade --no-cache
# JRE 17 Alpine Linux ?´ë?ì§€ ?¬ìš©

# ìµœì¢… ?´ë?ì§€???‘ì—… ?”ë ‰? ë¦¬ ?¤ì •
WORKDIR /app

# ë¹Œë“œ ?¤í…Œ?´ì??ì„œ ?ì„±???¤í–‰ ê°€?¥í•œ JAR ?Œì¼ ë³µì‚¬
# build/libs/*.jar ê²½ë¡œ??Gradle??ê¸°ë³¸ ë¹Œë“œ ê²°ê³¼ JAR ?Œì¼ ?„ì¹˜?…ë‹ˆ??
# Maven ?„ë¡œ?íŠ¸?¼ë©´ target/*.jar ??ê²ƒì…?ˆë‹¤.
COPY --from=builder /app/build/libs/*.jar app.jar

# ? í”Œë¦¬ì??´ì…˜??ë¦¬ìŠ¤?í•  ?¬íŠ¸ ?¸ì¶œ (?¤ì œ ?¤íŠ¸?Œí¬ ?¤ì •???„ìˆ˜?ì´ì§€???Šìœ¼??ë¬¸ì„œ??ëª©ì )
# ???¬íŠ¸ ë²ˆí˜¸??ê°??œë¹„?¤ì˜ application.yml ?Œì¼???¤ì •??server.port?€ ?¼ì¹˜?´ì•¼ ?©ë‹ˆ??
