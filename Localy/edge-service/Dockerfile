FROM eclipse-temurin:17-jdk-alpine AS builder
# JDK 17 Alpine Linux ?´ë?ì§€ ?¬ìš© (ê°€ë³ê³  ì¢‹ìŒ)

# ? í”Œë¦¬ì??´ì…˜ ?ŒìŠ¤ ì½”ë“œê°€ ?„ì¹˜???‘ì—… ?”ë ‰? ë¦¬ ?¤ì •
